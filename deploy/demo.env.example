# Copy to deploy/demo.env (gitignored — NEVER commit real values) and fill in.
#
# For DEPLOY: every image is a cosign-verified sha256 DIGEST, resolved + rendered
# into the bundle by demo-publish.yml (docs/demo-plan/02-deployment.md). The
# compose file itself stays digest-free so its in-repo hash is the published hash.
#
# For LOCAL GATE-1 (docker-compose.dev.yml builds warden+shim): plain tags are
# fine, e.g.  CADDY_IMAGE=caddy:2  SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3
# NETCANON_INSTANCE_IMAGE=ghcr.io/netcanon/netcanon:0.6.1

ACME_EMAIL=you@example.com

# Product image the warden spawns per session (digest-pinned in deploy):
NETCANON_INSTANCE_IMAGE=ghcr.io/netcanon/netcanon@sha256:REPLACE_WITH_PINNED_DIGEST

# Demo images (built + signed by demo-publish.yml):
WARDEN_IMAGE=ghcr.io/netcanon/netcanon-demo-warden@sha256:REPLACE
WARDEN_SHIM_IMAGE=ghcr.io/netcanon/netcanon-demo-warden-shim@sha256:REPLACE

# Third-party images (digest-pinned; verified at deploy):
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy@sha256:REPLACE
CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE
